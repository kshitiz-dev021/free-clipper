# Copy to .env (local Docker) or add each line as a Secret/Variable in your Hugging Face Space.
# Both keys are FREE and need no credit card.

# Google AI Studio key (Gemini 2.5 Flash): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq key (Whisper large-v3-turbo + Llama 3.3 70B fallback): https://console.groq.com/keys
GROQ_API_KEY=

# Speech-to-text engine: auto = Groq if a key is set, else local; or force groq | local
TRANSCRIBER=auto
# Local faster-whisper model used as the offline fallback: tiny | base
WHISPER_MODEL=base

# Origins allowed to call the API (comma-separated). Use your Vercel URL in production.
FRONTEND_ORIGINS=http://localhost:3000

# Optional limits and tuning
MAX_CONCURRENT_JOBS=1
LIVE_WINDOW_SECONDS=600
MAX_VOD_SECONDS=5400
JOB_TTL_SECONDS=7200

# Optional: base64 of a YouTube cookies.txt, only needed if YouTube blocks your host's IP.
# Create it with:  base64 -w0 cookies.txt
YTDLP_COOKIES_B64=
